# Environment Configuration for Deployment

# Base Public URL of the deployed application (e.g. https://dcbot-qf0i.onrender.com)
APP_URL=

# Secret token for authenticating Telegram Webhook updates (optional but recommended)
TELEGRAM_WEBHOOK_SECRET=

# Bot Credentials
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# Admin Authentication Secret Key
ADMIN_ACCESS_KEY=

# Database Connection URL (PostgreSQL / Supabase)
DATABASE_URL=
